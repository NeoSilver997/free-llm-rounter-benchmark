# Keys are read from the environment only, never written to disk.
# One variable per provider slug (catalog.loader.slug), e.g. "Google Gemini" -> ROUTER_KEY_GOOGLE_GEMINI.
# Providers left unset are excluded from routing with reason 'no_key'.

ROUTER_KEY_AION_LABS=
ROUTER_KEY_COHERE=
ROUTER_KEY_GOOGLE_GEMINI=
ROUTER_KEY_MISTRAL_AI=
ROUTER_KEY_Z_AI_ZHIPU_AI=

ROUTER_KEY_CLOUDFLARE_WORKERS_AI=
ROUTER_KEY_GROQ=
ROUTER_KEY_HUGGING_FACE=
ROUTER_KEY_KILO_CODE=
ROUTER_KEY_MODELSCOPE=
ROUTER_KEY_NVIDIA_NIM=
ROUTER_KEY_OLLAMA_CLOUD=
ROUTER_KEY_OPENROUTER=
ROUTER_KEY_SILICONFLOW=

# Anonymous tiers (no key needed): OVHcloud AI Endpoints, LLM7.io basic access.
# ROUTER_KEY_OVHCLOUD_AI_ENDPOINTS=
# ROUTER_KEY_LLM7_IO=

# Alternative: a single JSON map of provider slug -> key.
# LLM_ROUTER_KEYS={"groq":"...","openrouter":"..."}

# Cloudflare Workers AI needs the account id in its base URL.
CF_ACCOUNT_ID=
